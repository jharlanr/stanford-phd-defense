{
  "name": "greenland-defense",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Interactive explorable-dissertation website. Defense-day guided tour + post-defense free-explore mode.",
  "scripts": {
    "dev": "VITE_BASE=/stanford-phd-defense/ vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "shot": "node tools/screenshot.mjs",
    "shot:grid": "node tools/shot-grid.mjs --base=http://localhost:5173",
    "shot:beats": "node tools/shot-grid.mjs --base=http://localhost:5173 --chapter=ch1 --cols=3",
    "shot:watch": "node tools/shot-watch.mjs --base=http://localhost:5173"
  },
  "dependencies": {
    "three": "^0.184.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "^1.59.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
